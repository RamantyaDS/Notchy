{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notchy",
  "version": "0.2.3",
  "identifier": "com.notchy.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Notchy",
        "width": 600,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost tauri: asset: http://asset.localhost blob: data:; connect-src 'self' ipc: http://ipc.localhost https://api.open-meteo.com https://geocoding-api.open-meteo.com https://lrclib.net; img-src 'self' asset: http://asset.localhost data: blob: https:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$PICTURE/Screenshots/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyQzFCMzM2QTRFMThCMjcKUldRbmkrR2tOclBCUWtoNGFpOGtxemhRc3hOZy9pMEQ3SmR3ekkrWjFYd0xKa3hHd3BuS3ZzQWIK",
      "endpoints": ["https://github.com/RamantyaDS/Notchy/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
